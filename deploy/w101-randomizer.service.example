# Template only. Do not enable until the real catalog/manifest and private env file exist.
[Unit]
Description=W101 Randomizer local bridge (NOT Imlight game server)
After=network.target

[Service]
Type=simple
User=w101randomizer
Group=w101randomizer
WorkingDirectory=/opt/w101-randomizer
EnvironmentFile=/etc/w101-randomizer/bridge.env
ExecStart=/usr/bin/python3 -m randomizer.cli serve --catalog /opt/w101-randomizer/config/verified_catalog.json --manifest /opt/w101-randomizer/state/verified-manifest.json --db /opt/w101-randomizer/state/run.sqlite3 --host 127.0.0.1 --port 18951
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/w101-randomizer/state
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
